# ============================================================
# WenDao Docker Deployment — Environment Variables
# ============================================================
# Copy this file to .env.docker and fill in your actual values.
#   cp .env.docker.example .env.docker
#
# IMPORTANT: .env.docker contains secrets and is NOT committed to git.
# ============================================================

# ---- Domain (optional — leave empty for IP access) ----
# If you have a domain, set it here. Nginx will use "_" (match-all) if empty.
# DOMAIN=wendao.yourdomain.com

# ---- Database ----
DB_USERNAME=root
DB_PASSWORD=change-me-to-a-strong-password

# ---- Redis ----
# Leave empty for no password (matches existing config)
REDIS_PASSWORD=

# ---- Backend Secrets ----
# AES encryption key (32 characters) — CHANGE THIS for production!
# Generate with: openssl rand -base64 32 | cut -c1-32
WENDAO_AES_KEY=WenDao2026!AesKey#Secret@9876

# JWT token signing secret — CHANGE THIS for production!
# Generate with: openssl rand -base64 64
TOKEN_SECRET=change-me-to-a-random-64-character-string

# JWT token expiration in minutes
TOKEN_EXPIRE_TIME=30

# ---- AI Model (DeepSeek) ----
NEWS_AI_API_KEY=sk-your-deepseek-api-key-here

# ---- Production Security ----
# Swagger UI: set "false" in production (default)
SWAGGER_ENABLED=false
# Druid monitoring console: set "false" in production (default)
DRUID_STAT_ENABLED=false
# Log level for application code: "info" for production, "debug" for dev
LOG_LEVEL_COM_WENDAO=info

# ---- File Paths (inside container) ----
WENDAO_PROFILE=/home/wendao/uploadPath
LOG_PATH=/home/wendao/logs

# ---- Image Versions ----
# Use 'latest' for development, specific tags for production rollback
BACKEND_VERSION=latest
FRONTEND_VERSION=latest
