# ============================================================
# WenDao Frontend — Nginx Static File Server
# ============================================================
# Build context: project root (WenDao/)
# Static files are mounted from host (./ui/dist), not built in Docker.
# ============================================================

FROM nginx:1.27-alpine

# Install tzdata for timezone
RUN apk add --no-cache tzdata && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx configuration
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/default.conf.template /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
