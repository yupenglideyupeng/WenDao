# ============================================================
# WenDao Frontend — Multi-stage Docker Build
# ============================================================
# Build context: project root (WenDao/)
# Stage 1: Node 20 + yarn build:prod
# Stage 2: Nginx 1.27 Alpine serving static files
# ============================================================

# ---- Stage 1: Build ----
FROM node:20-alpine AS build

WORKDIR /build

# Copy package.json for dependency caching
COPY ui/package.json ./

# Install dependencies (using npmmirror for faster downloads in China)
RUN npm install --registry=https://registry.npmmirror.com

# Copy full frontend source
COPY ui/ .

# Build for production (uses .env.production: VITE_APP_BASE_API=/prod-api)
RUN npm run build:prod

# ---- Stage 2: Nginx Serve ----
FROM nginx:1.27-alpine

# Install tzdata for timezone
RUN apk add --no-cache tzdata && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx configuration
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/default.conf.template /etc/nginx/conf.d/default.conf

# Copy built static files
COPY --from=build /build/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
