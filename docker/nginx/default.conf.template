# ============================================================
# WenDao Nginx — HTTP-Only Site Config
# ============================================================
# Used for initial deployment (Phase 1, before SSL is configured).
# After obtaining SSL certificates, switch to default-ssl.conf.template.
# ============================================================
# ${DOMAIN} is substituted by envsubst at container startup.

server {
    listen 80;
    server_name _;    # 匹配所有请求（IP 或域名均可）

    # ========================================================
    # Main SPA (Vue Admin App)
    # ========================================================
    location / {
        root   /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
        index  index.html index.htm;

        # Cache static assets aggressively
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 30d;
            add_header Cache-Control "public, immutable";
        }
    }

    # ========================================================
    # Screen SPA (Data Dashboard)
    # ========================================================
    location /screen {
        alias /usr/share/nginx/html;
        try_files $uri $uri/ /screen.html;
        index screen.html;
    }

    # ========================================================
    # API Reverse Proxy → Backend
    # ========================================================
    # /prod-api/xxx → http://backend:8080/xxx
    location /prod-api/ {
        proxy_pass http://backend:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_read_timeout    120s;   # Long timeout for SSE streaming (AI interpretation)
        proxy_send_timeout    60s;

        # Buffering: disable for SSE streaming
        proxy_buffering off;
        proxy_cache off;

        # Increase buffer size for large responses
        proxy_buffer_size     128k;
        proxy_buffers         4 256k;
        proxy_busy_buffers_size 256k;
    }

    # ========================================================
    # WebSocket Proxy
    # ========================================================
    location /ws {
        proxy_pass http://backend:8080/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Long timeout for persistent WebSocket connections
        proxy_read_timeout 86400s;
    }

    # ========================================================
    # Swagger / SpringDoc
    # ========================================================
    location /v3/api-docs {
        proxy_pass http://backend:8080/v3/api-docs;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /swagger-ui {
        proxy_pass http://backend:8080/swagger-ui;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # ========================================================
    # Druid Monitoring Console
    # ========================================================
    location /druid {
        proxy_pass http://backend:8080/druid;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
