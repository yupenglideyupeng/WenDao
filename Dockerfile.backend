# ============================================================
# WenDao Backend — JDK 21 JRE Runtime
# ============================================================
# Build context: project root (WenDao/)
# JAR is mounted from host (./wendao-admin.jar), not built in Docker.
# ============================================================

FROM eclipse-temurin:21-jre-alpine

# Install curl for healthcheck, tzdata for timezone
RUN apk add --no-cache curl tzdata && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

# Create non-root user
RUN addgroup -S wendao && adduser -S wendao -G wendao

# Create application directories
RUN mkdir -p /home/wendao/uploadPath /home/wendao/logs /app/config && \
    chown -R wendao:wendao /home/wendao /app

# Copy Docker-specific logback config
COPY docker/backend/logback-docker.xml /app/config/logback-docker.xml

USER wendao
WORKDIR /app

EXPOSE 8080

ENV JAVA_OPTS="-Xms256m -Xmx512m -XX:MetaspaceSize=128m -XX:MaxMetaspaceSize=256m -Dlogging.config=/app/config/logback-docker.xml"

HEALTHCHECK --interval=30s --timeout=10s --retries=5 --start-period=60s \
    CMD curl -f -s http://localhost:8080/captchaImage || exit 1

ENTRYPOINT ["sh", "-c", "java ${JAVA_OPTS} -jar /app/wendao-admin.jar"]
